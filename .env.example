# Copy to /etc/vps-sentinel.env on the server
NODE_ENV=production
PORT=3999
HOST=127.0.0.1

# WebAuthn relying party - must match the public domain exactly
RP_ID=vps.grouvi.online
ORIGIN=https://vps.grouvi.online
RP_NAME=VPS Sentinel

STATE_DIR=/var/lib/vps-sentinel

# Collector cadence (ms)
FAST_INTERVAL_MS=2000
SLOW_INTERVAL_MS=15000
RARE_INTERVAL_MS=300000

# Session lifetime in minutes
SESSION_TTL_MIN=720
ENROLL_TTL_MIN=20

# Alert thresholds
DISK_WARN=80
DISK_CRIT=90
MEM_WARN=85
MEM_CRIT=94
CERT_WARN_DAYS=21
CERT_CRIT_DAYS=7
BACKUP_STALE_HOURS=36

BACKUP_DIRS=
DEPLOY_DIRS=
DISCOVERY_ROOTS=/opt,/srv,/var/www,/home,/root
DISCOVERY_INTERVAL_MS=900000

# Phase 1 persistence / alerting
HISTORY_PERSIST_INTERVAL_MS=10000
HISTORY_RETENTION_DAYS=30
INCIDENT_RESOLVE_GRACE_MS=45000
SENTINEL_TELEGRAM_BOT_TOKEN=
SENTINEL_TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_MIN=30

# Fleet mode: standalone, hub or node. Use one unique 32+ byte secret per node.
SENTINEL_ROLE=standalone
FLEET_NODE_ID=
FLEET_NODE_NAME=
FLEET_HUB_URL=
FLEET_SHARED_SECRET=
# Hub accepts either a string or [current,previous] for zero-downtime rotation.
FLEET_NODES_JSON={}
FLEET_PUSH_INTERVAL_MS=10000
FLEET_OFFLINE_AFTER_MS=45000
FLEET_MAX_SNAPSHOT_BYTES=524288
FLEET_INGEST_PER_MINUTE=30
FLEET_ALLOWED_IPS=

SENTINEL_RELEASE_REPO=grouvi25/vps-sentinel
UPDATE_CHECK_INTERVAL_MS=1800000
FS_INDEX_INTERVAL_MS=1800000
FS_MAX_ENTRIES=60000

# Optional isolated AI bridge socket
SENTINEL_AI_BRIDGE_SOCKET=/run/sentinel-ai/bridge.sock
