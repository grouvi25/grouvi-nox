# Copy to /etc/vps-sentinel.env on the server
NODE_ENV=production
PORT=3999
HOST=127.0.0.1

# WebAuthn relying party - must match the public domain exactly
RP_ID=vps.grouvi.online
ORIGIN=https://vps.grouvi.online
RP_NAME=VPS Sentinel

STATE_DIR=/var/lib/vps-sentinel

# Collector cadence (ms)
FAST_INTERVAL_MS=2000
SLOW_INTERVAL_MS=15000
RARE_INTERVAL_MS=300000

# Session lifetime in minutes
SESSION_TTL_MIN=720
ENROLL_TTL_MIN=20

# Alert thresholds
DISK_WARN=80
DISK_CRIT=90
MEM_WARN=85
MEM_CRIT=94
CERT_WARN_DAYS=21
CERT_CRIT_DAYS=7
BACKUP_STALE_HOURS=36

BACKUP_DIRS=/opt/coursebot/backups,/opt/mmo90s/backups,/opt/reip/backups

# Phase 1 persistence / alerting
HISTORY_PERSIST_INTERVAL_MS=10000
HISTORY_RETENTION_DAYS=30
INCIDENT_RESOLVE_GRACE_MS=45000
SENTINEL_TELEGRAM_BOT_TOKEN=
SENTINEL_TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_MIN=30
