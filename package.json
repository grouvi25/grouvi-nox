{
  "name": "grouvi-nox-vps-sentinel",
  "version": "1.26.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Grouvi Nox: realtime VPS monitoring, fleet telemetry and passkey-secured operations dashboard",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "enroll": "node bin/enroll.js",
    "recovery": "node bin/enroll.js --recovery",
    "status": "node bin/enroll.js --status",
    "test": "node --test tests/unit/*.test.js",
    "check": "npm test && npm run test:coverage && npm run audit:paths && npm run test:visual && npm audit --audit-level=low",
    "test:visual": "node tests/visual/layout.test.js",
    "test:coverage": "node scripts/check-coverage.js",
    "audit:paths": "node scripts/audit-hardcoded-paths.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1",
    "better-sqlite3": "^11.8.1",
    "cookie": "^1.0.2",
    "express": "^4.21.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
